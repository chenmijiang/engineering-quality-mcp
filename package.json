{
  "name": "quality-analysis-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Quality analysis MCP server",
  "homepage": "https://github.com/chenmijiang/quality-analysis-mcp#readme",
  "bugs": {
    "url": "https://github.com/chenmijiang/quality-analysis-mcp/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmijiang/quality-analysis-mcp.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --minify",
    "start": "bun dist/index.js",
    "oxlint": "oxlint",
    "oxfmt": "oxfmt .",
    "oxfmt:check": "oxfmt --check .",
    "test": "bun --bun vitest run --pool=threads",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "typebox": "1.3.27",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "^1.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "^7.1.0-beta.tsrs4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts}": [
      "oxfmt",
      "oxlint --deny-warnings"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml}": "oxfmt"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
